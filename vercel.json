{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{.github/**,docs/**,grafana/**,monitoring/**,target-app/**,load-tests/**,backend/tests/**,ml/tests/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
